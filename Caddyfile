{
	email {$ACME_EMAIL}
	# The admin API is not needed: configuration changes go through a container restart
	admin off
}

# Security headers shared by all sites; "header" replaces values set by the backends,
# so no header appears twice. The Content-Security-Policy stays with each frontend.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
}

# One file per project
import sites/*.caddy
