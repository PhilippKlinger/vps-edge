# Public status page: Uptime Kuma from vps-monitoring, reached over the internal network "monitoring".
# Kuma serves dashboard, login and socket.io on the same port, so only the public status page
# is let through; everything else returns 404 here. The dashboard is used through an SSH tunnel.
status.philipp-klinger.com {
	import security_headers
	encode zstd gzip

	# Start page: the platform overview with one group per project
	redir / /status/overview

	# Status page, its read-only API, badges and the static files of the single-page app
	@public {
		method GET HEAD
		path /status/* /api/status-page/* /api/badge/* /assets/* /upload/* /icon.svg /favicon.ico /apple-touch-icon.png /apple-touch-icon-precomposed.png /manifest.json /robots.txt
	}
	handle @public {
		reverse_proxy uptime-kuma:3001
	}

	handle {
		respond 404
	}
}
